@*
Họ và tên: Phạm Quang Nhật
Mã sinh viên: 23203100085
Nội dung thực hiện: Quản lý sinh viên, đăng ký ở KTX, xem thông tin/lịch sử ở
*@
@model SinhVienLichSuVM
@{ var hienTai = Model.PhanPhongs.FirstOrDefault(p => p.TrangThai == TT.Dang); }
<div class="detail-hero">
    <span class="head-kicker">Student profile</span>
    <h2>Lịch sử ở KTX: @Model.SinhVien.HoTen</h2>
    <p>@Model.SinhVien.MaSinhVien · @Model.SinhVien.GioiTinh · Lớp @Model.SinhVien.Lop - @Model.SinhVien.Khoa · @Model.SinhVien.TrangThai</p>
    <div class="summary-grid">
        <div class="summary-card"><div class="summary-icon">📝</div><div class="summary-label">Số đăng ký</div><div class="summary-value">@Model.DangKys.Count</div></div>
        <div class="summary-card"><div class="summary-icon">🏠</div><div class="summary-label">Số phòng từng ở</div><div class="summary-value">@Model.SoPhongDaO</div></div>
        <div class="summary-card"><div class="summary-icon">🔁</div><div class="summary-label">Số lần chuyển phòng</div><div class="summary-value">@Model.SoLanChuyen</div></div>
        <div class="summary-card"><div class="summary-icon">🛏️</div><div class="summary-label">Phòng hiện tại</div><div class="summary-value">@(hienTai == null ? "Chưa có" : hienTai.Phong.TenPhong)</div></div>
    </div>
</div>
<div class="section-header"><div class="head-copy"><span class="head-kicker">Room timeline</span><h3>Lịch sử phân phòng</h3></div></div>
@if (Model.PhanPhongs.Count == 0) { <p><i>Sinh viên chưa từng được phân phòng.</i></p> } else {
<div class="table-panel"><div class="table-wrap"><table><tr><th>Phòng</th><th>Loại</th><th>Tòa</th><th>Tầng</th><th>Ngày vào</th><th>Ngày ra</th><th>Trạng thái</th></tr>
@foreach (var p in Model.PhanPhongs) {
<tr><td>@p.Phong.TenPhong</td><td>@p.Phong.LoaiPhong.TenLoaiPhong</td><td>@p.Phong.ToaNha</td><td>@p.Phong.Tang</td><td>@p.NgayVao.ToString("dd/MM/yyyy")</td><td>@(p.NgayRa?.ToString("dd/MM/yyyy"))</td><td><span class="status-pill">@p.TrangThai</span></td></tr> }
</table></div></div> }
<div class="section-header section-spaced"><div class="head-copy"><span class="head-kicker">Applications</span><h3>Các đăng ký</h3></div></div>
@if (Model.DangKys.Count == 0) { <p><i>Sinh viên chưa có đăng ký nào.</i></p> } else {
<div class="table-panel"><div class="table-wrap"><table><tr><th>Mã</th><th>Ngày đăng ký</th><th>Bắt đầu</th><th>Kết thúc dự kiến</th><th>Nguyện vọng</th><th>Trạng thái</th><th></th></tr>
@foreach (var d in Model.DangKys) {
<tr><td>@d.MaDangKy</td><td>@d.NgayDangKy.ToString("dd/MM/yyyy")</td><td>@d.NgayBatDau.ToString("dd/MM/yyyy")</td><td>@d.NgayKetThucDuKien.ToString("dd/MM/yyyy")</td><td>@d.LoaiPhongNV?.TenLoaiPhong</td><td><span class="status-pill">@d.TrangThai</span></td>
<td><a class="btn btn-secondary" asp-controller="DangKyKTX" asp-action="Details" asp-route-id="@d.MaDangKy">Chi tiết</a></td></tr> }
</table></div></div> }
<div class="form-actions"><a class="btn btn-secondary" asp-action="Index">Quay lại danh sách sinh viên</a></div>
