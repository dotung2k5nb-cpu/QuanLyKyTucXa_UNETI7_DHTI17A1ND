@*
Họ và tên: Đỗ Văn Tùng
Mã sinh viên: 23203100028
Nội dung thực hiện: Tài khoản, đăng nhập, phân quyền, quản lý loại phòng
*@
@model LoginVM
<div class="auth-wrap">
    <div class="auth-panel">
        <div class="auth-copy">
            <h2>Đăng nhập</h2>
            <p>Quản lý ký túc xá UNETI theo mô hình dashboard hiện đại, tối ưu theo dõi sinh viên, phòng và đăng ký nhanh chóng.</p>
            <div class="info-list">
                <span>Admin: admin / admin123</span>
                <span>Sinh viên: SV12346 / SV12346</span>
            </div>
        </div>
        <div class="auth-form">
            <div asp-validation-summary="ModelOnly"></div>
            <form method="post" asp-action="Login" class="f login-transition-form">
                <label asp-for="TenDangNhap"></label>
                <input asp-for="TenDangNhap" autofocus />
                <span asp-validation-for="TenDangNhap"></span>

                <label asp-for="MatKhau"></label>
                <input asp-for="MatKhau" />
                <span asp-validation-for="MatKhau"></span>

                <div class="form-actions">
                    <button type="submit">Đăng nhập</button>
                </div>
            </form>
        </div>
    </div>
</div>
