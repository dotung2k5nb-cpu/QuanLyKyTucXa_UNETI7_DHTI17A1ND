@model QuanLyKyTucXa_UNETI7_TI17A1ND.Models.DangKyKTX

<h2>Từ chối đăng ký KTX cho @Model.SinhVien.HoTen</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form asp-action="TuChoi" method="post">
    <input type="hidden" name="id" value="@Model.MaDangKy" />

    <div class="form-group">
        <label>Mã sinh viên:</label>
        <input type="text" class="form-control" value="@Model.MaSinhVien" readonly />
    </div>

    <div class="form-group">
        <label>Họ tên:</label>
        <input type="text" class="form-control" value="@Model.SinhVien.HoTen" readonly />
    </div>

    <div class="form-group">
        <label>Lý do từ chối:</label>
        <textarea name="LyDo" class="form-control" required></textarea>
    </div>

    <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>