@*
Họ và tên: Phạm Quang Nhật
Mã sinh viên: 23203100085
Nội dung thực hiện: Quản lý sinh viên, đăng ký ở KTX, xem thông tin/lịch sử ở
*@
@model DangKyKTX
<div class="page-header"><div class="head-copy"><span class="head-kicker">Student portal</span><h2>Đăng ký ở ký túc xá</h2></div></div>
<div asp-validation-summary="All"></div>
<div class="form-card">
<p class="form-intro">Chọn thời gian lưu trú dự kiến và gửi nguyện vọng phòng để ban quản lý xét duyệt.</p>
<form method="post" class="f">
<label asp-for="NgayBatDau"></label><input asp-for="NgayBatDau" type="date" value="@Model.NgayBatDau.ToString("yyyy-MM-dd")" /><span asp-validation-for="NgayBatDau"></span>
<label asp-for="NgayKetThucDuKien"></label><input asp-for="NgayKetThucDuKien" type="date" value="@Model.NgayKetThucDuKien.ToString("yyyy-MM-dd")" /><span asp-validation-for="NgayKetThucDuKien"></span>
<label asp-for="NguyenVongLoaiPhong"></label><select asp-for="NguyenVongLoaiPhong" asp-items="(SelectList)ViewBag.Loais"><option value="">-- Không chọn --</option></select>
<label asp-for="GhiChu"></label><textarea asp-for="GhiChu" rows="3"></textarea>
<div class="form-actions"><button type="submit">Gửi đăng ký</button></div></form>
</div>
