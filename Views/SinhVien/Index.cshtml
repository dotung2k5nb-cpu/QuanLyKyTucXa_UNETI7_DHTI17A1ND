@*
Họ và tên: Phạm Quang Nhật
Mã sinh viên: 23203100085
Nội dung thực hiện: Quản lý sinh viên, đăng ký ở KTX, xem thông tin/lịch sử ở
*@
@model SinhVienListVM
<div class="page-header">
    <div class="head-copy">
        <span class="head-kicker">Members</span>
        <h2>Sinh viên</h2>
    </div>
    <a class="btn" asp-action="Create">Thêm sinh viên</a>
</div>

<div class="filter-panel">
    <div class="filter-heading">
        <strong>Tìm kiếm và lọc sinh viên</strong>
        <span>Tìm theo mã/tên; các điều kiện được kết hợp đồng thời.</span>
    </div>
    <form method="get" class="filter-form">
        <label class="filter-field"><span>Mã sinh viên</span><input name="maSv" value="@Model.MaSinhVien" placeholder="Ví dụ: SV12346" /></label>
        <label class="filter-field"><span>Họ và tên</span><input name="hoTen" value="@Model.HoTen" placeholder="Nhập một phần họ tên" /></label>
        <label class="filter-field"><span>Lớp</span><input name="lop" value="@Model.Lop" placeholder="Ví dụ: DHTI17A1ND" /></label>
        <label class="filter-field"><span>Khoa</span><input name="khoa" value="@Model.Khoa" placeholder="Ví dụ: CNTT" /></label>
        <label class="filter-field"><span>Giới tính</span>
            <select name="gioiTinh"><option value="">Tất cả giới tính</option><option value="@TT.Nam" selected="@(Model.GioiTinh == TT.Nam)">@TT.Nam</option><option value="@TT.Nu" selected="@(Model.GioiTinh == TT.Nu)">@TT.Nu</option></select>
        </label>
        <label class="filter-field"><span>Trạng thái tài khoản</span>
            <select name="tt"><option value="">Tất cả trạng thái</option><option value="@TT.HoatDong" selected="@(Model.Tt == TT.HoatDong)">@TT.HoatDong</option><option value="@TT.Khoa" selected="@(Model.Tt == TT.Khoa)">@TT.Khoa</option></select>
        </label>
        <div class="filter-actions"><button type="submit">Tìm sinh viên</button><a class="btn btn-secondary" asp-action="Index">Đặt lại</a></div>
    </form>
</div>

<p>Kết quả: <b>@Model.Items.Count</b> sinh viên.</p>
@if (Model.Items.Count == 0) { <p><i>Không tìm thấy sinh viên phù hợp. Hãy kiểm tra lại mã, tên hoặc điều kiện lọc.</i></p> } else {
<div class="table-panel">
    <div class="table-wrap">
        <table>
            <tr><th>Mã SV</th><th>Họ tên</th><th>Giới tính</th><th>Lớp</th><th>Khoa</th><th>SĐT</th><th>Trạng thái</th><th>Hành động</th></tr>
            @foreach (var s in Model.Items) {
            <tr>
                <td>@s.MaSinhVien</td>
                <td>@s.HoTen</td>
                <td>@s.GioiTinh</td>
                <td>@s.Lop</td>
                <td>@s.Khoa</td>
                <td>@s.SoDienThoai</td>
                <td><span class="status-pill">@s.TrangThai</span></td>
                <td>
                    <div class="actions-cell">
                        <a class="btn btn-secondary" asp-action="LichSu" asp-route-id="@s.MaSinhVien">Lịch sử</a>
                        <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@s.MaSinhVien">Sửa</a>
                        <form class="inline" method="post" asp-action="Khoa" asp-route-id="@s.MaSinhVien"><button class="btn2">@(s.TrangThai == TT.HoatDong ? "Khóa" : "Mở khóa")</button></form>
                        <form class="inline" method="post" asp-action="DatLaiMatKhau" asp-route-id="@s.MaSinhVien" data-confirm="Bạn có chắc muốn đặt lại mật khẩu của sinh viên này?" data-confirm-title="Đặt lại mật khẩu" data-confirm-button="Đặt lại"><button class="btn2">Đặt lại MK</button></form>
                    </div>
                </td>
            </tr> }
        </table>
    </div>
</div>
}
